<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Ui/etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">devanshi_customsalesorders_order_listing.devanshi_customsalesorders_order_listing_data_source</item>
            <item name="deps" xsi:type="string">devanshi_customsalesorders_order_listing.devanshi_customsalesorders_order_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">devanshi_customsalesorders_order_listing_columns</item>
    </argument>
    <dataSource name="devanshi_customsalesorders_order_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Devanshi\CustomSalesOrders\Ui\Component\Listing\DataProvider</argument>
            <argument name="name" xsi:type="string">devanshi_customsalesorders_order_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
        </argument>
    </dataSource>
    <columns name="devanshi_customsalesorders_order_listing_columns">
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label>Order ID</label>
            </settings>
        </column>
        <column name="customer_firstname">
            <settings>
                <label>Customer Name</label>
            </settings>
        </column>
        <column name="created_at">
            <settings>
                <filter>dateRange</filter>
                <label>Created At</label>
            </settings>
        </column>
        <column name="grand_total">
            <settings>
                <filter>textRange</filter>
                <label>Grand Total</label>
            </settings>
        </column>
        <exportButton name="export_button"/>
    </columns>
</listing>
