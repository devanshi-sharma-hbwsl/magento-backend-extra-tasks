<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Catalog\Block\Product\ListProduct" name="category.products.list" as="product_list" template="Vendor3_Compare::product/compare/list.phtml"/>
        </referenceContainer>
        <referenceBlock name="category.product.list.additional">
            <block class="Vendor3\Compare\Block\CompareButton" name="compare.button" template="Vendor3_Compare::product/compare/button.phtml" after="-">
                <arguments>
                    <argument name="selected_products" xsi:type="array">
                        <item name="0" xsi:type="string">0</item>
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>